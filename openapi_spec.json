{
  "openapi": "3.1.0",
  "info": {
    "title": "IPSS-R Myelodysplastic Calculator API",
    "version": "1.0.0",
    "description": "Published IPSS-R scoring and a separate, experimental generic audit workflow. Clinical score is prognostic, not treatment guidance."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Browser calculator",
        "responses": {
          "200": {
            "description": "HTML user interface"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service available"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory operational counters",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/calculate": {
      "post": {
        "summary": "Calculate IPSS-R prognostic score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IPSSRInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score, risk category, and component points"
          },
          "422": {
            "description": "Missing or invalid parameter"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate generic audit workflow (not clinical IPSS-R)",
        "responses": {
          "200": {
            "description": "Audit dossier"
          },
          "422": {
            "description": "Validation failure"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock chat response (not verified clinical guidance)",
        "responses": {
          "200": {
            "description": "Mock response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Inspect in-memory audit log",
        "responses": {
          "200": {
            "description": "Audit hashes and integrity result"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IPSSRInput": {
        "type": "object",
        "required": [
          "cytogenetic_risk",
          "blast_pct",
          "hemoglobin",
          "platelets",
          "anc"
        ],
        "properties": {
          "cytogenetic_risk": {
            "type": "string",
            "enum": [
              "very_good",
              "good",
              "intermediate",
              "poor",
              "very_poor"
            ]
          },
          "blast_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Bone marrow blasts (%)"
          },
          "hemoglobin": {
            "type": "number",
            "minimum": 0,
            "description": "g/dL"
          },
          "platelets": {
            "type": "number",
            "minimum": 0,
            "description": "10^9/L"
          },
          "anc": {
            "type": "number",
            "minimum": 0,
            "description": "10^9/L"
          }
        }
      }
    }
  }
}
